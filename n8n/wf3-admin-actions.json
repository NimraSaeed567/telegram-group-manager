      "id": "5e823b1f-d44f-4143-b6a7-3a0238f6c03b",
      "name": "Get settings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Translate the dashboard request into one Telegram Bot API call.\nconst b = $('Webhook').first().json.body || {};\nconst s = $('Get settings').first().json || {};\nconst mins = s.mute_minutes || 60;\nconst by = b.admin || 'dashboard';\nconst chat_id = Number(b.chat_id);\nconst user_id = Number(b.user_id);\nconst ids = { chat_id, user_id };\nconst allOn = {\n  can_send_messages: true, can_send_audios: true, can_send_documents: true, can_send_photos: true,\n  can_send_videos: true, can_send_video_notes: true, can_send_voice_notes: true, can_send_polls: true,\n  can_send_other_messages: true, can_add_web_page_previews: true, can_invite_users: true,\n};\nconst allOff = Object.fromEntries(Object.keys(allOn).map(k => [k, false]));\nconst base = { valid: true, chatId: chat_id, userId: user_id, by, details: {}, reset: false };\n\nswitch (b.action) {\n  case 'send_message':\n    return [{ json: { ...base, kind: 'message', method: 'sendMessage', params: { chat_id, text: String(b.text || '') }, text: String(b.text || '') } }];\n  case 'ban':\n    return [{ json: { ...base, kind: 'member', method: 'banChatMember', params: ids, status: 'banned', event: 'ban' } }];\n  case 'unban':\n    return [{ json: { ...base, kind: 'member', method: 'unbanChatMember', params: { ...ids, only_if_banned: true }, status: 'left', event: 'unban', reset: true } }];\n  case 'mute':\n    return [{ json: { ...base, kind: 'member', method: 'restrictChatMember',\n      params: { ...ids, permissions: allOff, until_date: Math.floor(Date.now() / 1000) + mins * 60 },\n      status: 'muted', event: 'mute', details: { minutes: mins } } }];\n  case 'unmute':\n    return [{ json: { ...base, kind: 'member', method: 'restrictChatMember', params: { ...ids, permissions: allOn }, status: 'active', event: 'unmute' } }];\n}\nreturn [{ json: { valid: false, error: 'Invalid action' } }];"
      },
