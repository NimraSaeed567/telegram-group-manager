    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.supabaseUrl }}/rest/v1/settings?chat_id=eq.{{ Number($('Webhook').first().json.body.chat_id) }}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config').first().json.supabaseKey }}"
