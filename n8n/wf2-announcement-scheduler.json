{
  "name": "WF2 - Announcement Scheduler",
  "nodes": [
    {
      "parameters": {
        "content": "## WF2 — Announcement Scheduler\nEvery minute: claim announcements whose time has come (status pending → sent in one atomic update, so nothing is posted twice), post them, and mark any that fail.",
        "height": 160,
        "width": 700,
        "color": 5
      },
      "id": "3a2b021c-b0e0-4dd8-a654-3919cfd30988",
      "name": "Note dce41d",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -300
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "9826d517-076a-4044-8824-93804f97cc33",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f21b8b50-cb3b-42e0-9cad-afcf2ab417e0",
              "name": "botToken",
              "value": "YOUR_BOT_TOKEN",
              "type": "string"
            },
            {
              "id": "12bcc40a-ad5d-4d74-83f4-c3e7dac3d0d7",
              "name": "supabaseUrl",
              "value": "https://YOUR_PROJECT.supabase.co",
              "type": "string"
            },
            {
              "id": "2fffe6d1-0b95-40cb-9c99-cd4a479393ae",
              "name": "supabaseKey",
              "value": "YOUR_SUPABASE_SERVICE_ROLE_KEY",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "2ec21806-e4c9-4910-9563-fce51e08de8c",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Config').first().json.supabaseUrl }}/rest/v1/announcements?status=eq.pending&scheduled_at=lte.{{ new Date().toISOString() }}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config').first().json.supabaseKey }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.supabaseKey }}"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'sent', sent_at: new Date().toISOString() }) }}"
      },
      "id": "72bc1180-8941-4707-8acb-bea6384ec0da",
      "name": "Claim due announcements",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "94b0548c-8290-47f1-abf9-88155e6513b0",
              "leftValue": "={{ !!$json.id }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "51f644f4-33c8-4609-b5cb-7bb0a5ef4331",
      "name": "Anything due?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $('Config').first().json.botToken }}/sendMessage",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.chat_id, text: $json.text }) }}"
      },
      "id": "859e8d4b-d56e-40ed-9766-7ff783a6a757",
      "name": "Post to group",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "6508d40c-5c54-4cf5-aa10-cb9e23979c99",
              "leftValue": "={{ $json.ok === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "de01944c-d574-46b8-bcda-4cb3f8f7cc23",
      "name": "Posted?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabaseUrl }}/rest/v1/activity_log",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config').first().json.supabaseKey }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.supabaseKey }}"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $('Claim due announcements').item.json.chat_id, event_type: 'announcement', details: { text: $('Claim due announcements').item.json.text, by: 'scheduler', announcement_id: $('Claim due announcements').item.json.id } }) }}"
      },
      "id": "16e8a125-7918-44d4-8171-63043f58ecd6",
      "name": "Log announcement",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        -100
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Config').first().json.supabaseUrl }}/rest/v1/announcements?id=eq.{{ $('Claim due announcements').item.json.id }}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config').first().json.supabaseKey }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.supabaseKey }}"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'failed', sent_at: null, error: $json.description || $json.error?.message || 'Send failed' }) }}"
      },
      "id": "00acd820-d778-4b15-9951-326c5ef58dec",
      "name": "Mark failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        100
      ]
    }
  ],
